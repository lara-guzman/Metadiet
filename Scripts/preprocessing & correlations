# # ===============================
# PART 16 – REPEATED-MEASURES CORRELATION (rmcorr)
# ===============================

# Prepare dataframe for rmcorr
library(rmcorr)

alphadiv_cocorr <- data.frame(
  individual = goldberry_alpha_df$id,
  rich_gut = goldberry_alpha_df$richness,
  rich_diet = diet_alpha_df$richness,
  time = goldberry_alpha_df$time
)

# Apply repeated-measures correlation
rm_result <- rmcorr(
  participant = "individual",
  measure1    = "rich_gut",
  measure2    = "rich_diet",
  dataset     = alphadiv_cocorr
)

summary(rm_result)

===============================
PART 17 – DIET BETA DIVERSITY
===============================
diet_clr_thresh_dist <- dist_calc(
  diet_clr_thresh_filtered,
  dist = "euclidean"
) %>%
  dist_get()

metadata_diet <- data.frame(
  sample_data(diet_clr_thresh_filtered)
)

adonis2(
  diet_clr_thresh_dist ~ time,
  data = metadata_diet,
  strata = metadata_diet$subject,
  permutations = 4999
)

Homogeneity of dispersion 

betadisper_test_diet <- betadisper(
  diet_clr_thresh_dist,
  metadata_diet$time
)

anova(betadisper_test_diet)


===============================
GUT MICROBIOTA – BETA DIVERSITY 
===============================

### Gut microbiota ----

# Distance (Euclidean on CLR = Aitchison)
goldberry_ait_dist <- dist_calc(
  goldberry.rare2.clr,
  dist = "euclidean"
) %>%
  dist_get()

# Metadata
metadata_microbiota <- data.frame(
  sample_data(goldberry.rare2.clr)
)

# PERMANOVA simple
adonis2(
  goldberry_ait_dist ~ treatment,
  data = metadata_microbiota,
  permutations = 999
)

# PERMANOVA estratificado (longitudinal)
adonis2(
  goldberry_ait_dist ~ treatment,
  data = metadata_microbiota,
  strata = metadata_microbiota$individual,
  permutations = 999
)

betadisper_micro <- betadisper(
  goldberry_ait_dist,
  metadata_microbiota$treatment
)

anova(betadisper_micro)

===============================
PROCRUSTES
===============================

### Plasma metabolome ----
# Euclidean distances
plasma_met_eucl <- vegdist(plasma_met, method = "euclidean", upper = FALSE, diag = FALSE)

# Aitchison distances
plasma_met.clr <- clr(plasma_met)
plasma_met_ait <- vegdist(plasma_met.clr, method = "euclidean", upper = FALSE, diag = FALSE)

### Diet-Metabolome ----
protest(X = as.matrix(diet_clr_thresh_dist), Y = as.matrix(plasma_met_eucl), scores = "sites", permutations = 9999)

### Microbiota-Metabolome ----
protest(X = as.matrix(goldberry_ait_dist), Y = as.matrix(plasma_met_ait), scores = "sites", permutations = 9999)

### Microbiota-Diet ----
protest(X = as.matrix(goldberry_ait_dist), Y = as.matrix(diet_clr_thresh_dist), scores = "sites", permutations = 9999)








