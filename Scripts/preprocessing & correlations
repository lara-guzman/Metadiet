# Coefficient of variation (CV%)
cv <- function(x) {
  abs(sd(x, na.rm = TRUE) / mean(x, na.rm = TRUE)) * 100
}

# ===============================
# Color palette
# ===============================

myPalette <- RColorBrewer::brewer.pal(12, "Paired")

# ===============================
# PART 3 – LOAD trnL DATA
# ===============================

# Import OTU table
taxa_table <- read.delim(
  here::here("data/trnL/assigned_sequences_UCH_Dic_analysis.csv"),
  sep = ";",
  row.names = 1
)

# Keep abundance columns only
taxa_table <- taxa_table[, 6:ncol(taxa_table)]

# Remove taxa with zero total counts
taxa_table <- taxa_table %>%
  dplyr::filter(rowSums(dplyr::across(where(is.numeric))) != 0)

otus_m <- as.matrix(taxa_table)

# Import metadata
samples_table <- read.delim(
  here::here("data/trnL/metadata_UCH.txt"),
  sep = "\t",
  row.names = 1
)

# Import taxonomy
taxonomy_table <- read.delim(
  here::here("data/trnL/Taxonomy_UCH.txt"),
  sep = "\t",
  row.names = 1
)

# Create phyloseq object
diet <- phyloseq(
  otu_table(otus_m, taxa_are_rows = TRUE),
  tax_table(as.matrix(taxonomy_table)),
  sample_data(samples_table)
)

# Basic sanity check
nsamples(diet)
ntaxa(diet)

# ===============================
# PART 4 – DECONTAMINATION
# ===============================

# Library size check
df_diet <- as.data.frame(sample_data(diet))
df_diet$LibrarySize <- sample_sums(diet)

ggplot(df_diet, aes(x = reorder(rownames(df_diet), LibrarySize),
                    y = LibrarySize,
                    color = sample_type)) +
  geom_point(size = 3) +
  theme_classic() +
  labs(x = "Samples", y = "Library size")

contam_freq <- isContaminant(
  diet,
  method = "frequency",
  conc = "DNA_concentration"
)

table(contam_freq$contaminant)

diet_decontam_freq <- prune_taxa(
  !contam_freq$contaminant,
  diet
)

# ===============================
# PART 5 – FILTER SAMPLES
# ===============================

# Remove controls
diet_clean <- prune_samples(
  sample_data(diet_decontam_freq)$sample_type == "sample",
  diet_decontam_freq
)

# Remove taxa with zero counts
diet_clean <- filter_taxa(
  diet_clean,
  function(x) sum(x) > 0,
  prune = TRUE
)

# Check sequencing depth
depths <- sample_sums(diet_clean)
summary(depths)

# Optional: retain samples > 10,000 reads
diet_clean <- prune_samples(depths > 10000, diet_clean)

nsamples(diet_clean)
ntaxa(diet_clean)


# ===============================
# PART 6 – RAREFACTION
# ===============================

set.seed(5600)

diet_rarefied <- rarefy_even_depth(
  diet_clean,
  sample.size = 3950,
  rngseed = 5600,
  replace = FALSE,
  verbose = TRUE
)

# Remove taxa absent after rarefaction
diet_rarefied <- filter_taxa(
  diet_rarefied,
  function(x) sum(x) > 0,
  prune = TRUE
)

summary(sample_sums(diet_rarefied))

# ===============================
# PART 7 – CLR TRANSFORMATION
# ===============================

# Add pseudocount to avoid log(0)
diet_rarefied_pseudo <- transform_sample_counts(
  diet_rarefied,
  function(x) x + 1
)

# CLR transformation
diet_clr <- microbiome::transform(
  diet_rarefied_pseudo,
  "clr"
)

# ===============================
# PART 8 – GUT MICROBIOTA
# ===============================

# Load data
otu_mat <- read_excel(here::here("data/16S/uchuva_only.otus.xlsx"))
tax_mat <- read_excel(here::here("data/16S/uchuva.taxonomy.xlsx"))
samples_df <- read_excel(here::here("data/16S/uchuva_only.meta.xlsx"))

# Define row names
otu_mat <- tibble::column_to_rownames(otu_mat, var = "otu")
tax_mat <- tibble::column_to_rownames(tax_mat, var = "otu")
samples_df <- tibble::column_to_rownames(samples_df, var = "sample")

# Convert to matrices
otu_mat <- as.matrix(otu_mat)
tax_mat <- as.matrix(tax_mat)

# Create phyloseq object
goldberry <- phyloseq(
  otu_table(otu_mat, taxa_are_rows = TRUE),
  tax_table(tax_mat),
  sample_data(samples_df)
)

nsamples(goldberry)
ntaxa(goldberry)

sample_data(goldberry)$is.neg <- sample_data(goldberry)$sample_type == "control"

contam_prev_16S <- isContaminant(
  goldberry,
  method = "prevalence",
  neg = "is.neg"
)

table(contam_prev_16S$contaminant)

# Remove contaminant taxa
goldberry_noncontam <- prune_taxa(
  !contam_prev_16S$contaminant,
  goldberry
)

# Remove controls
goldberry_noncontam <- prune_samples(
  sample_data(goldberry_noncontam)$sample_type != "control",
  goldberry_noncontam
)

set.seed(5600)

goldberry_rarefied <- rarefy_even_depth(
  goldberry_noncontam,
  sample.size = 1457,
  replace = FALSE,
  verbose = TRUE
)

summary(sample_sums(goldberry_rarefied))

# Add pseudocount
goldberry_pseudo <- transform_sample_counts(
  goldberry_rarefied,
  function(x) x + 1
)

goldberry_clr <- microbiome::transform(
  goldberry_pseudo,
  "clr"
)

===============================
PART 9 – EMPIRICAL SENSITIVITY ASSESSMENT (trnL)
===============================

# This section evaluates the empirical lower detectable CLR abundance 
# using the positive control (mock community) samples included in the trnL run.
# This is NOT a formal limit of quantification (LOQ), since CLR values 
# depend on the compositional structure of each sample.
# Instead, we estimate the minimum observed CLR value among expected taxa
# in the mock community after full preprocessing.

# -------------------------------
# 9.1 Identify positive controls
# -------------------------------

# Extract positive control samples after full preprocessing
trnl_pos_controls <- prune_samples(
  sample_data(diet_clr)$sample_type %in% c("CPOS.trnl", "CP"),
  diet_clr
)

sample_names(trnl_pos_controls)

# -------------------------------
# 9.2 Define expected taxa in mock
# -------------------------------

# Mock community taxa (as defined in experimental design)
mock_expected_taxa <- c(
  "Otu002","Otu018","Otu023","Otu027","Otu033",
  "Otu040","Otu042","Otu051","Otu056","Otu060",
  "Otu078","Otu080","Otu082","Otu088","Otu089",
  "Otu094","Otu100"
)

# Retain only expected taxa
mock_expected_clr <- prune_taxa(
  taxa_names(trnl_pos_controls) %in% mock_expected_taxa,
  trnl_pos_controls
)

ntaxa(mock_expected_clr)

# -------------------------------
# 9.3 Empirical minimum detectable CLR abundance
# -------------------------------

# Extract CLR abundance matrix
mock_clr_matrix <- as.matrix(otu_table(mock_expected_clr))

# Compute empirical minimum detected CLR value
min_detectable_clr_mock <- min(mock_clr_matrix, na.rm = TRUE)

min_detectable_clr_mock

# ===============================
# PART 10 – PLASMA METABOLOME
# ===============================

# Load identified metabolites
plasma_met <- read.delim(
  file = here::here("data/metabolomics/DB_metabolomics_TENTATIVE_ID_uchuva.csv"),
  header = TRUE,
  sep = ";",
  row.names = 1
)

# Remove non-quantitative columns
plasma_met$Status <- NULL

# Order samples alphabetically
plasma_met <- plasma_met[order(rownames(plasma_met)),]

dim(plasma_met)

# -------------------------------
# 11.1 Define treatment vector
# -------------------------------

treatment <- rep(c("Baseline", "Chronic"), length.out = nsamples(diet_clr))

# -------------------------------
# 11.2 Select samples used in integration analyses
# -------------------------------

sam_basic <- c(
  "UCH.02.2b.trnl","UCH.02.2c.trnl.1","UCH.02.2c.trnl.2",
  "UCH.03.3b","UCH.03.3c",
  "UCH.04.4b.trnl","UCH.04.4c.trnl",
  "UCH.05.5b","UCH.05.5c",
  "UCH.07.7b.trnl","UCH.07.7c.trnl",
  "UCH.08.8b","UCH.08.8c",
  "UCH.09.9b.trnl.1","UCH.09.9b.trnl.2","UCH.09.9c.trnl",
  "UCH.10.10b","UCH.10.10c",
  "UCH.11.11b.trnl","UCH.11.11c.trnl",
  "UCH.12.12b","UCH.12.12c",
  "UCH.13.13b.trnl","UCH.13.13c.trnl",
  "UCH.15.15b","UCH.15.15c",
  "UCH.16.16b","UCH.16.16b.trnl","UCH.16.16c",
  "UCH.17.17b","UCH.17.17c",
  "UCH.18.18b.trnl","UCH.18.18c.trnl",
  "UCH.19.19b","UCH.19.19c",
  "UCH.20.T1b.trnl","UCH.20.T2c.trnl",
  "UCH.21.21b","UCH.21.21c"
)

diet_subset <- prune_samples(
  sample_names(diet_clr) %in% sam_basic,
  diet_clr
)

# -------------------------------
# 11.3 Apply empirical detection threshold
# -------------------------------

# Values below the empirically observed minimum detectable CLR abundance
# in the mock community are set to zero.
# This is used as a conservative sensitivity filtering step.

threshold_zero <- function(x){
  ifelse(x < min_detectable_clr_mock, 0, x)
}

diet_subset_clr_thresh <- transform_sample_counts(
  diet_subset,
  threshold_zero
)

# Remove taxa that become absent after thresholding
diet_subset_clr_thresh <- filter_taxa(
  diet_subset_clr_thresh,
  function(x) sum(x > 0) > 0,
  prune = TRUE
)

# -------------------------------
# 11.4 Remove spike-in species
# -------------------------------

diet_subset_clr_thresh <- prune_taxa(
  taxa_names(diet_subset_clr_thresh) != "Otu043",
  diet_subset_clr_thresh
)

# -------------------------------
# 11.5 Alpha diversity preparation
# -------------------------------

# Remove non-identified OTUs (retain curated set)
otus_to_remove <- rownames(otu_table(diet_subset_clr_thresh))[
  grep("^Otu[1-9][0-9]{2,}$", rownames(otu_table(diet_subset_clr_thresh)))
]

otus_to_remove <- setdiff(
  otus_to_remove,
  c("Otu100","Otu101","Otu102","Otu103")
)

diet_alpha_ready <- prune_taxa(
  !(taxa_names(diet_subset_clr_thresh) %in% otus_to_remove),
  diet_subset_clr_thresh
)

ntaxa(diet_alpha_ready)
nsamples(diet_alpha_ready)

===============================
PART 12 – DIET ALPHA DIVERSITY
===============================

diet_richness <- diversityresult(
  x = t(otu_table(diet_alpha_ready)),
  index = "richness",
  method = "each site"
)

diet_shannon <- diversityresult(
  x = t(otu_table(diet_alpha_ready)),
  index = "Shannon",
  method = "each site"
)

diet_evenness <- diversityresult(
  x = t(otu_table(diet_alpha_ready)),
  index = "Jevenness",
  method = "each site"
)

# Combine into single dataframe
diet_alpha_df <- cbind(
  diet_richness,
  diet_shannon,
  diet_evenness,
  time = sample_data(diet_alpha_ready)$time,
  id = sample_data(diet_alpha_ready)$id
)

summary(diet_alpha_df)

samples_to_remove <- c(
  "UCH.02.2c.trnl.2",
  "UCH.09.9b.trnl.2",
  "UCH.16.16b.trnl"
)

diet_alpha_ready_filtered <- prune_samples(
  !(sample_names(diet_alpha_ready) %in% samples_to_remove),
  diet_alpha_ready
)

diet_richness_filt <- diversityresult(
  x = t(otu_table(diet_alpha_ready_filtered)),
  index = "richness",
  method = "each site"
)

diet_shannon_filt <- diversityresult(
  x = t(otu_table(diet_alpha_ready_filtered)),
  index = "Shannon",
  method = "each site"
)

diet_evenness_filt <- diversityresult(
  x = t(otu_table(diet_alpha_ready_filtered)),
  index = "Jevenness",
  method = "each site"
)

diet_alpha_df <- cbind(
  diet_richness_filt,
  diet_shannon_filt,
  diet_evenness_filt,
  time = sample_data(diet_alpha_ready_filtered)$time,
  id = sample_data(diet_alpha_ready_filtered)$id
)

sd_richness <- sd(diet_alpha_df$richness, na.rm = TRUE)
print(sd_richness)

diet_alpha_df <- diet_alpha_df %>%
  mutate(
    id = ifelse(id == "UCH_20_BasalInter1", "UCH_20_Basal", id),
    id = ifelse(id == "UCH_20_CronicoInter2", "UCH_20_Cronico", id)
  )

